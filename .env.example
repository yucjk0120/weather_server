# Cloudflare Tunnel で外部公開する場合に .env としてコピーして使う
#   cp .env.example .env
# .env は Git 管理外（トークンを含むため）

# docker compose up で一緒に起動する追加サービス（カンマ区切り）
#   tunnel   : cloudflared（外部公開）
#   receiver : receiver-bridge（USB でつないだ気象受信機のデータを登録）
COMPOSE_PROFILES=tunnel

# Zero Trust ダッシュボードで発行したトンネルトークン
TUNNEL_TOKEN=
